{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	"entry": [
		// Next.js convention files using .tsx extension (knip's Next.js plugin only matches .ts)
		"app/robots.tsx",
		"app/sitemap.tsx"
	],
	"ignoreDependencies": [
		// Referenced as string literals in next.config.ts webpack function
		"@griffel/webpack-loader",
		// Ambient type declarations for gtag global
		"@types/gtag.js",
		// Existing package retained because dependency cleanup is outside this upgrade
		"globals",
		// Used by Jest to parse TypeScript config (jest.config.ts)
		"ts-node"
	],
	"ignoreIssues": {
		// Intentional named and default type exports for internal and public consumers
		"app/theme/color-mode.ts": ["duplicates"]
	},
	"ignoreExportsUsedInFile": true
}
